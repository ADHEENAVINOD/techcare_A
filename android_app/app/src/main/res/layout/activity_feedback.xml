<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Technician Feedback"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_feedback_tech_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Technician: Loading..."
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Provide your detailed feedback / review:"
        android:textSize="14sp"
        android:textColor="@color/text_color"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_feedback_text"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:hint="Tell us about your experience..."
        android:inputType="textMultiLine"
        android:gravity="top"
        android:padding="12dp"
        android:background="@drawable/edit_text_bg"
        android:layout_marginBottom="24dp"
        android:textColor="@color/text_color"/>

    <Button
        android:id="@+id/btn_feedback_submit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="SUBMIT FEEDBACK"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:backgroundTint="@color/primary"/>

</LinearLayout>
