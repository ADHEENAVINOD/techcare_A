<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:margin="8dp"
    android:background="@drawable/edit_text_bg"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tv_item_comp_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Product Name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tv_item_comp_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date: 2026-07-16 | Status: Pending"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_item_comp_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Issue description details..."
        android:textSize="14sp"
        android:textColor="@color/text_color"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estimate: "
            android:textSize="14sp"
            android:textColor="@color/text_muted"/>

        <TextView
            android:id="@+id/tv_item_comp_estimate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending / ₹500"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/success"/>
    </LinearLayout>

    <!-- Offers Button (Visible when status is Pending, Estimated, or Accepted) -->
    <Button
        android:id="@+id/btn_item_comp_offers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Technician Bids / Offers"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/accent"
        android:textColor="@color/white"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button"/>

    <!-- Estimate Action Buttons (Visible when status is 'Estimated') -->
    <LinearLayout
        android:id="@+id/layout_item_comp_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gap="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_item_comp_approve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Approve"
            android:backgroundTint="@color/success"
            android:textColor="@color/white"
            android:layout_marginRight="4dp"/>

        <Button
            android:id="@+id/btn_item_comp_reject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reject"
            android:backgroundTint="@color/danger"
            android:textColor="@color/white"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>

    <!-- Service Assignment / Follow-up Buttons (Visible when technician is assigned) -->
    <LinearLayout
        android:id="@+id/layout_item_comp_assignment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_item_comp_tech"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assigned: Ramesh Kumar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_item_comp_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"
                android:layout_marginRight="4dp"
                style="@style/Widget.MaterialComponents.Button.MinWidth"/>

            <Button
                android:id="@+id/btn_item_comp_feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Feedback"
                android:backgroundTint="@color/primary_light"
                android:textColor="@color/primary"
                android:layout_marginRight="4dp"
                style="@style/Widget.MaterialComponents.Button.MinWidth"/>

            <Button
                android:id="@+id/btn_item_comp_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rate Co."
                android:backgroundTint="@color/primary_light"
                android:textColor="@color/primary"
                android:layout_marginRight="4dp"
                style="@style/Widget.MaterialComponents.Button.MinWidth"/>

            <Button
                android:id="@+id/btn_item_comp_receipt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Receipt"
                android:backgroundTint="@color/accent"
                android:textColor="@color/white"
                style="@style/Widget.MaterialComponents.Button.MinWidth"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
