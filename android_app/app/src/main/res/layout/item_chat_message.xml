<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Left Bubble (Incoming Message) -->
    <LinearLayout
        android:id="@+id/layout_chat_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:orientation="vertical"
        android:background="@drawable/chat_bubble_left"
        android:padding="12dp"
        android:maxWidth="260dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_chat_text_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming message text"
            android:textColor="@color/black"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_chat_time_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:00 PM"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:layout_gravity="right"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Right Bubble (Outgoing Message) -->
    <LinearLayout
        android:id="@+id/layout_chat_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:orientation="vertical"
        android:background="@drawable/chat_bubble_right"
        android:padding="12dp"
        android:maxWidth="260dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_chat_text_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Outgoing message text"
            android:textColor="@color/white"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_chat_time_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:01 PM"
            android:textColor="@color/white"
            android:alpha="0.7"
            android:textSize="10sp"
            android:layout_gravity="right"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

</RelativeLayout>
