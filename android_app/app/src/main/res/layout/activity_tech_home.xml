<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Custom Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_dark"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tech_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Technician Dashboard"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_tech_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned Service Tasks"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:alpha="0.8"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_tech_logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textColor="@color/white"
            android:backgroundTint="@color/danger"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </LinearLayout>

    <!-- Tab Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="2dp"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_tab_my_tasks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Tasks"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:layout_marginRight="4dp"
            style="@style/Widget.MaterialComponents.Button"/>

        <Button
            android:id="@+id/btn_tab_find_jobs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Find Open Jobs"
            android:backgroundTint="@color/primary_light"
            android:textColor="@color/primary"
            android:layout_marginLeft="4dp"
            style="@style/Widget.MaterialComponents.Button"/>
    </LinearLayout>

    <!-- List Section Header -->
    <TextView
        android:id="@+id/tv_tech_section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active Assignments"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/text_color"
        android:layout_margin="16dp"/>

    <ListView
        android:id="@+id/lv_tech_jobs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/border_color"
        android:dividerHeight="1dp"
        android:padding="8dp"/>

</LinearLayout>
