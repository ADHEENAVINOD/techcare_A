<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Header Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Technician Bids &amp; Offers"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Complaint Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/edit_text_bg"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tv_offers_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product: Dell Laptop"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_color"/>

        <TextView
            android:id="@+id/tv_offers_complaint_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fault description here..."
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active Offers from Technicians"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_color"
        android:layout_marginBottom="8dp"/>

    <!-- List View of Offers -->
    <ListView
        android:id="@+id/lv_technician_offers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/border_color"
        android:dividerHeight="1dp"/>

</LinearLayout>
