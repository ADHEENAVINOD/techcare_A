<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Full Screen Mock Video Feed (Technician stream view) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#203a43">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔧 TechCare Remote Diagnostics"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_video_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected (Secure encrypted line)"
            android:textColor="@color/success"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tv_video_tech_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analyzing fault in device hardware..."
            android:textColor="@color/white"
            android:textSize="16sp"
            android:alpha="0.8"/>
    </LinearLayout>

    <!-- Picture-in-Picture Local Preview (Client camera view mockup) -->
    <androidx.cardview.widget.CardView
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:elevation="8dp"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="#56141414">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Local Camera\nPreview (You)"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="8dp"/>
    </androidx.cardview.widget.CardView>

    <!-- Calling overlay info -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="120dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_video_recipient_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipient Name"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy Guard Enabled (Numbers hidden)"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- End Call Button -->
    <Button
        android:id="@+id/btn_end_call"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:text="End"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:backgroundTint="@color/danger"
        style="@style/Widget.MaterialComponents.Button.MinWidth"
        android:elevation="12dp"
        android:insetBottom="0dp"
        android:insetTop="0dp"/>

</RelativeLayout>
