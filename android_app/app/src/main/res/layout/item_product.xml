<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:margin="8dp"
    android:background="@drawable/edit_text_bg"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_item_product_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Product Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary"/>

        <TextView
            android:id="@+id/tv_item_product_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹500"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/success"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_item_product_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Product description details go here..."
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_item_product_request"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Request Technical Assistance"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:backgroundTint="@color/primary"
        style="@style/Widget.MaterialComponents.Button.MinWidth"/>

</LinearLayout>
